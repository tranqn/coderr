# Environment for the Coderr Docker image. Copy to `.env`, edit it, and pass it
# to the container with `docker run --env-file .env ...`.

# Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# Never run a public deployment with DEBUG=True.
DJANGO_DEBUG=False

# Hosts/IPs/domains that may serve this app. For a quick trial deployment "*"
# accepts any host; restrict it to your domain/IP in production.
DJANGO_ALLOWED_HOSTS=*

# Required for the Django admin login when served over HTTPS behind a proxy.
# Comma-separated, scheme included, e.g. https://coderr.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- HTTPS hardening -------------------------------------------------------
# Leave False for plain-HTTP deployments. Set True ONLY once TLS terminates in
# front of the app (reverse proxy / load balancer); it then forces HTTPS
# redirects, HSTS and secure cookies. Enabling it without TLS causes redirect
# loops.
DJANGO_SECURE_SSL=False
# HSTS max-age in seconds (only applies when DJANGO_SECURE_SSL=True).
DJANGO_SECURE_HSTS_SECONDS=31536000

# Cross-origin browser origins allowed to call the API (only used when
# DEBUG=False). Same-origin behind nginx needs nothing here. Comma-separated,
# scheme included, e.g. https://app.example.com
DJANGO_CORS_ALLOWED_ORIGINS=

# Set to 1 to seed demo data on first start.
SEED_DEMO_DATA=0
